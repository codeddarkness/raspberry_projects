#!/bin/bash

# Master LLM Setup Script
# Universal installation and management for Ollama + Open WebUI
# Supports Debian/Ubuntu Linux and macOS Intel with CPU/GPU options

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="2.0.0"

echo "=========================================="
echo "Master LLM Setup Script v$VERSION"
echo "Universal Ollama + Open WebUI Installation"
echo "=========================================="

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

print_header() {
    echo -e "${CYAN}=== $1 ===${NC}"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

show_usage() {
    echo "Usage: $0 [install|status|update|troubleshoot|models|clean]"
    echo ""
    echo "Commands:"
    echo "  install      - Full installation of Ollama + Open WebUI"
    echo "  status       - Check status of all services"
    echo "  update       - Update components to latest versions"
    echo "  troubleshoot - Run comprehensive diagnostics"
    echo "  models       - Interactive model management"
    echo "  clean        - Clean up installations and data"
    echo "  help         - Show this help message"
    echo ""
    echo "Quick start: $0 install"
}

# Detect system information
detect_system() {
    OS="$(uname -s)"
    ARCH="$(uname -m)"
    
    case "$OS" in
        Linux*)
            OS="Linux"
            if [ -f /etc/debian_version ]; then
                DISTRO="Debian"
            elif [ -f /etc/redhat-release ]; then
                DISTRO="RedHat"
            else
                DISTRO="Unknown"
            fi
            ;;
        Darwin*)
            OS="macOS"
            DISTRO="macOS"
            ;;
        *)
            print_error "Unsupported operating system: $OS"
            exit 1
            ;;
    esac
    
    case "$ARCH" in
        x86_64|amd64) ARCH="x64" ;;
        arm64|aarch64) ARCH="arm64" ;;
        *)
            print_error "Unsupported architecture: $ARCH"
            exit 1
            ;;
    esac
    
    print_info "Detected: $OS $DISTRO ($ARCH)"
}

# Check system resources
check_system_resources() {
    print_header "System Resources"
    
    if [ "$OS" = "Linux" ]; then
        TOTAL_RAM=$(free -m | awk '/^Mem:/{print $2}')
        AVAILABLE_SPACE=$(df / | tail -1 | awk '{print $4}')
    elif [ "$OS" = "macOS" ]; then
        TOTAL_RAM=$(($(sysctl -n hw.memsize) / 1024 / 1024))
        AVAILABLE_SPACE=$(df / | tail -1 | awk '{print $4}')
    fi
    
    AVAILABLE_GB=$((AVAILABLE_SPACE / 1024 / 1024))
    
    echo "  RAM: ${TOTAL_RAM}MB"
    echo "  Available disk space: ${AVAILABLE_GB}GB"
    
    # Resource recommendations
    if [ $TOTAL_RAM -lt 4000 ]; then
        print_warning "Low RAM detected. Only small models (1-3B parameters) recommended."
    elif [ $TOTAL_RAM -lt 8000 ]; then
        print_info "Medium RAM detected. Models up to 7B parameters should work."
    elif [ $TOTAL_RAM -lt 16000 ]; then
        print_success "Good RAM detected. Models up to 13B parameters should work."
    else
        print_success "Excellent RAM detected. Large models (70B+) supported with GPU."
    fi
    
    if [ $AVAILABLE_GB -lt 20 ]; then
        print_warning "Low disk space. May limit number of models you can install."
    fi
}

# Check for component scripts
check_component_scripts() {
    print_info "Checking for component scripts in: $SCRIPT_DIR"
    
    local scripts=(
        "universal_ollama_install.sh"
        "universal_openwebui_install.sh" 
        "universal_diagnostics.sh"
    )
    
    for script in "${scripts[@]}"; do
        local script_path="$SCRIPT_DIR/$script"
        if [ ! -f "$script_path" ]; then
            print_error "Component script $script not found in $SCRIPT_DIR"
            print_info "Please ensure all installation scripts are in the same directory."
            echo "Required scripts:"
            for s in "${scripts[@]}"; do
                echo "  - $s"
            done
            exit 1
        fi
        chmod +x "$script_path"
    done
    
    print_success "All component scripts found and ready."
}

# Full installation process
install_full() {
    print_header "Starting Full Installation"
    
    detect_system
    check_system_resources
    check_component_scripts
    
    echo ""
    print_info "Installation will proceed in the following order:"
    echo "  1. Install system dependencies"
    echo "  2. Install and configure Ollama"
    echo "  3. Setup model library system"
    echo "  4. Install Open WebUI with Docker"
    echo "  5. Configure connectivity and test"
    echo "  6. Install recommended models"
    
    read -p "Continue with installation? (Y/n): " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Nn]$ ]]; then
        echo "Installation cancelled."
        exit 0
    fi
    
    # Run Ollama installation
    print_header "Installing Ollama"
    bash "$SCRIPT_DIR/universal_ollama_install.sh"
    
    # Run Open WebUI installation
    print_header "Installing Open WebUI"
    bash "$SCRIPT_DIR/universal_openwebui_install.sh"
    
    # Run diagnostics
    print_header "Running Post-Installation Diagnostics"
    bash "$SCRIPT_DIR/universal_diagnostics.sh"
    
    # Final setup
    create_master_management_script
    
    print_header "Installation Complete!"
    show_final_instructions
}

# Check status of all components
check_status() {
    print_header "System Status Check"
    
    echo "1. Ollama Service:"
    if command -v ollama &> /dev/null; then
        print_success "Ollama installed"
        if curl -s http://localhost:11434/api/tags > /dev/null; then
            print_success "Ollama API accessible"
            MODEL_COUNT=$(ollama list | tail -n +2 | wc -l)
            echo "   Installed models: $MODEL_COUNT"
        else
            print_warning "Ollama API not responding"
        fi
    else
        print_error "Ollama not installed"
    fi
    
    echo ""
    echo "2. Docker Service:"
    if command -v docker &> /dev/null; then
        print_success "Docker installed"
        if docker ps > /dev/null 2>&1; then
            print_success "Docker running"
        else
            print_warning "Docker not running or not accessible"
        fi
    else
        print_error "Docker not installed"
    fi
    
    echo ""
    echo "3. Open WebUI:"
    local docker_cmd
    if groups $USER | grep -q docker 2>/dev/null; then
        docker_cmd="docker"
    else
        docker_cmd="sudo docker"
    fi
    
    if $docker_cmd ps | grep -q open-webui; then
        print_success "Open WebUI container running"
        
        # Test web access
        local web_url=""
        for port in 8080 3000; do
            if curl -s http://localhost:$port > /dev/null; then
                web_url="http://localhost:$port"
                print_success "Web interface accessible at $web_url"
                break
            fi
        done
        
        if [ -z "$web_url" ]; then
            print_warning "Web interface not accessible"
        fi
    else
        print_error "Open WebUI container not running"
    fi
    
    echo ""
    echo "4. Model Library:"
    if [ -f ~/ollama-models/library/ollama_model_library.list ]; then
        local total_models=$(wc -l < ~/ollama-models/library/ollama_model_library.list)
        print_success "Model library available ($total_models models)"
    else
        print_warning "Model library not found"
    fi
    
    echo ""
    echo "Management Scripts:"
    local scripts=(
        "~/ollama-launcher.sh"
        "~/ollama-models.sh" 
        "~/openwebui-manager.sh"
        "~/ollama-webui-verify.sh"
    )
    
    for script in "${scripts[@]}"; do
        if [ -f "$script" ]; then
            print_success "$(basename $script) available"
        else
            print_warning "$(basename $script) missing"
        fi
    done
}

# Interactive model management
manage_models() {
    print_header "Interactive Model Management"
    
    if ! command -v ollama &> /dev/null; then
        print_error "Ollama not installed. Please run: $0 install"
        exit 1
    fi
    
    # Update model library
    print_info "Updating model library..."
    if [ -f ~/ollama-models.sh ]; then
        bash ~/ollama-models.sh update-library
    else
        setup_model_library
    fi
    
    while true; do
        echo ""
        echo "Model Management Options:"
        echo "1. List installed models"
        echo "2. Search available models"
        echo "3. Install a model"
        echo "4. Remove a model"
        echo "5. Show model details"
        echo "6. Recommended models for your system"
        echo "7. Exit"
        
        read -p "Choose option (1-7): " -n 1 -r
        echo
        
        case $REPLY in
            1)
                echo "Installed models:"
                ollama list
                ;;
            2)
                read -p "Enter search term: " search_term
                if [ -f ~/ollama-models/library/ollama_model_library.list ]; then
                    echo "Matching models:"
                    grep -i "$search_term" ~/ollama-models/library/ollama_model_library.list | head -10
                else
                    print_warning "Model library not available"
                fi
                ;;
            3)
                read -p "Enter model name (e.g., gemma2:2b): " model_name
                if [ ! -z "$model_name" ]; then
                    echo "Installing $model_name..."
                    ollama pull "$model_name"
                fi
                ;;
            4)
                echo "Installed models:"
                ollama list
                read -p "Enter model name to remove: " model_name
                if [ ! -z "$model_name" ]; then
                    ollama rm "$model_name"
                fi
                ;;
            5)
                read -p "Enter model name for details: " model_name
                if [ ! -z "$model_name" ]; then
                    ollama show "$model_name" 2>/dev/null || echo "Model not found or not installed"
                fi
                ;;
            6)
                show_recommended_models
                ;;
            7)
                break
                ;;
            *)
                print_warning "Invalid option"
                ;;
        esac
    done
}

# Setup model library system
setup_model_library() {
    print_info "Setting up model library system..."
    
    mkdir -p ~/ollama-models/library
    cd ~/ollama-models/library
    
    # Create enhanced model list script
    cat > get_model_list.sh << 'EOF'
#!/usr/bin/env bash

url=https://ollama.com/library
file_url=ollama_model_library
file_source=${file_url}.source
file_model_list=${file_url}.list
file_html=${file_url}.html
file_library_info=${file_url}.info

echo "Downloading Ollama model library..."

# Download model library source
curl -s "$url" > ${file_source}

# Parse models from source
grep '\/library\/' ${file_source} | cut -d'"' -f2 | cut -d'/' -f3 | sort -u > ${file_model_list}

# Render source into text (if html2text available)
if command -v html2text &> /dev/null; then
    html2text ${file_source} > ${file_html}
    
    # Extract model descriptions
    paste <(
        grep -o 'title=.*.class\|text-md.*' ${file_source} | grep '^title' | cut -d'"' -f2 | sed 's/$/ :/g') <(
            grep -o 'title=.*.class\|text-md.*' ${file_source} | grep '^text' | sed 's/\<\/p\>$//g' | cut -d'>' -f2 ) > ${file_library_info}.tmp 2>/dev/null
    
    if [ -f ${file_library_info}.tmp ]; then
        column -s: -t ${file_library_info}.tmp > ${file_library_info} 2>/dev/null || cp ${file_library_info}.tmp ${file_library_info}
        rm -f ${file_library_info}.tmp
    fi
else
    echo "html2text not available - skipping detailed descriptions"
fi

echo "Model library updated: $(wc -l < ${file_model_list}) models available"
EOF
    
    chmod +x get_model_list.sh
    ./get_model_list.sh
    
    cd - > /dev/null
}

# Show recommended models based on system
show_recommended_models() {
    print_header "Recommended Models for Your System"
    
    # Get system info
    if [ "$OS" = "Linux" ]; then
        TOTAL_RAM=$(free -m | awk '/^Mem:/{print $2}')
    elif [ "$OS" = "macOS" ]; then
        TOTAL_RAM=$(($(sysctl -n hw.memsize) / 1024 / 1024))
    fi
    
    echo "Based on your system ($OS, ${TOTAL_RAM}MB RAM):"
    echo ""
    
    if [ $TOTAL_RAM -ge 32000 ]; then
        echo "🚀 Large Models (32GB+ RAM):"
        echo "  • llama3.1:70b - Top performance, latest Llama model"
        echo "  • qwen2.5:72b - Excellent multilingual support"
        echo "  • mixtral:8x7b - Mixture of experts, efficient"
        echo "  • codellama:34b - Advanced code generation"
    elif [ $TOTAL_RAM -ge 16000 ]; then
        echo "💪 Medium Models (16GB+ RAM):"
        echo "  • llama3.1:8b - Great balance of size/performance"
        echo "  • qwen2.5:14b - Strong reasoning capabilities"
        echo "  • mistral:7b - Fast and efficient"
        echo "  • codellama:13b - Good code generation"
        echo "  • gemma2:9b - Google's latest, well-optimized"
    elif [ $TOTAL_RAM -ge 8000 ]; then
        echo "⚡ Small-Medium Models (8GB+ RAM):"
        echo "  • qwen2.5:7b - Excellent performance for size"
        echo "  • llama3.1:3b - Latest Llama, good efficiency"
        echo "  • phi3:3.8b - Microsoft's efficient model"
        echo "  • gemma2:2b - Very fast, good for chat"
        echo "  • codellama:7b - Decent code generation"
    else
        echo "🔋 Tiny Models (<8GB RAM):"
        echo "  • phi3:mini - 3.8B parameters, very efficient"
        echo "  • gemma2:2b - Fast and lightweight"
        echo "  • qwen2.5:1.5b - Smallest but capable"
    fi
    
    echo ""
    echo "Specialized models (all sizes):"
    echo "  • llava:7b - Vision + language understanding"
    echo "  • nomic-embed-text - Text embeddings"
    echo "  • all-minilm - Sentence embeddings"
    
    echo ""
    read -p "Install recommended models for your system? (y/N): " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        install_recommended_models
    fi
}

# Install recommended models
install_recommended_models() {
    local models=()
    
    if [ $TOTAL_RAM -ge 32000 ]; then
        models=("llama3.1:8b" "qwen2.5:14b" "mixtral:8x7b")
    elif [ $TOTAL_RAM -ge 16000 ]; then
        models=("llama3.1:8b" "qwen2.5:7b" "mistral:7b")
    elif [ $TOTAL_RAM -ge 8000 ]; then
        models=("qwen2.5:7b" "gemma2:2b" "phi3:3.8b")
    else
        models=("phi3:mini" "gemma2:2b")
    fi
    
    for model in "${models[@]}"; do
        echo "Installing $model..."
        ollama pull "$model" || print_warning "Failed to install $model"
    done
    
    print_success "Model installation complete!"
}

# Create master management script
create_master_management_script() {
    cat > ~/llm-manager.sh << 'EOF'
#!/bin/bash

# Master LLM Management Script
# Unified interface for Ollama + Open WebUI

show_usage() {
    echo "LLM Manager - Unified Ollama + Open WebUI Control"
    echo ""
    echo "Usage: $0 [command]"
    echo ""
    echo "System Commands:"
    echo "  start     - Start all services (Ollama + WebUI)"
    echo "  stop      - Stop all services"
    echo "  restart   - Restart all services"
    echo "  status    - Show status of all components"
    echo ""
    echo "Model Commands:"
    echo "  models    - List installed models"
    echo "  search    - Search available models"
    echo "  install   - Install a model interactively"
    echo "  remove    - Remove a model interactively"
    echo ""
    echo "Web Interface:"
    echo "  open      - Open WebUI in browser"
    echo "  logs      - Show WebUI logs"
    echo ""
    echo "Maintenance:"
    echo "  update    - Update all components"
    echo "  diagnose  - Run diagnostics"
    echo "  verify    - Quick system verification"
}

start_services() {
    echo "Starting LLM services..."
    
    # Start Ollama
    if command -v ollama &> /dev/null; then
        if ! curl -s http://localhost:11434/api/tags > /dev/null; then
            echo "Starting Ollama..."
            if [[ "$(uname)" == "Linux" ]] && systemctl is-enabled ollama &> /dev/null; then
                sudo systemctl start ollama
            else
                ollama serve > /tmp/ollama.log 2>&1 &
            fi
            sleep 3
        else
            echo "✓ Ollama already running"
        fi
    else
        echo "✗ Ollama not installed"
        return 1
    fi
    
    # Start Open WebUI
    local docker_cmd
    if groups $USER | grep -q docker 2>/dev/null; then
        docker_cmd="docker"
    else
        docker_cmd="sudo docker"
    fi
    
    if $docker_cmd ps | grep -q open-webui; then
        echo "✓ Open WebUI already running"
    elif $docker_cmd ps -a | grep -q open-webui; then
        echo "Starting Open WebUI container..."
        $docker_cmd start open-webui
    else
        echo "✗ Open WebUI container not found"
        echo "Please run the installation script first"
        return 1
    fi
    
    sleep 2
    echo "Services started!"
}

stop_services() {
    echo "Stopping LLM services..."
    
    # Stop Open WebUI
    local docker_cmd
    if groups $USER | grep -q docker 2>/dev/null; then
        docker_cmd="docker"
    else
        docker_cmd="sudo docker"
    fi
    
    if $docker_cmd ps | grep -q open-webui; then
        $docker_cmd stop open-webui
        echo "✓ Open WebUI stopped"
    fi
    
    # Stop Ollama (Linux only via systemd)
    if [[ "$(uname)" == "Linux" ]] && systemctl is-active ollama &> /dev/null; then
        sudo systemctl stop ollama
        echo "✓ Ollama stopped"
    else
        echo "! Ollama running manually - stop with Ctrl+C in terminal"
    fi
}

case $1 in
    start) start_services ;;
    stop) stop_services ;;
    restart) stop_services; sleep 2; start_services ;;
    status) 
        if [ -f ~/ollama-webui-verify.sh ]; then
            bash ~/ollama-webui-verify.sh
        else
            echo "Status check script not found"
        fi
        ;;
    models) ollama list ;;
    search) 
        read -p "Enter search term: " term
        if [ -f ~/ollama-models.sh ]; then
            bash ~/ollama-models.sh search "$term"
        else
            echo "Model search script not found"
        fi
        ;;
    install)
        read -p "Enter model name: " model
        ollama pull "$model"
        ;;
    remove)
        ollama list
        read -p "Enter model name to remove: " model
        ollama rm "$model"
        ;;
    open)
        for port in 8080 3000; do
            if curl -s http://localhost:$port > /dev/null; then
                if command -v open &> /dev/null; then
                    open http://localhost:$port
                elif command -v xdg-open &> /dev/null; then
                    xdg-open http://localhost:$port
                else
                    echo "Open http://localhost:$port in your browser"
                fi
                exit 0
            fi
        done
        echo "WebUI not accessible"
        ;;
    logs)
        local docker_cmd
        if groups $USER | grep -q docker 2>/dev/null; then
            docker_cmd="docker"
        else
            docker_cmd="sudo docker"
        fi
        $docker_cmd logs -f open-webui
        ;;
    update)
        echo "Updating components..."
        # Update Ollama
        curl -fsSL https://ollama.com/install.sh | sh
        # Update WebUI
        if groups $USER | grep -q docker 2>/dev/null; then
            docker pull ghcr.io/open-webui/open-webui:main
        else
            sudo docker pull ghcr.io/open-webui/open-webui:main
        fi
        echo "Update complete - restart services to use new versions"
        ;;
    diagnose)
        if [ -f ~/universal_diagnostics.sh ]; then
            bash ~/universal_diagnostics.sh
        else
            echo "Diagnostic script not found"
        fi
        ;;
    verify)
        if [ -f ~/ollama-webui-verify.sh ]; then
            bash ~/ollama-webui-verify.sh
        else
            echo "Verification script not found"
        fi
        ;;
    *) show_usage ;;
esac
EOF
    
    chmod +x ~/llm-manager.sh
    print_success "Created master management script: ~/llm-manager.sh"
}

# Show final instructions
show_final_instructions() {
    echo ""
    print_header "🎉 Installation Complete!"
    echo ""
    
    echo "Your LLM setup is now ready! Here's what was installed:"
    echo ""
    echo "📦 Components:"
    echo "  • Ollama - Local LLM server"
    echo "  • Open WebUI - Web interface for chat"
    echo "  • Model Library System - Browse and install models"
    echo "  • Management Scripts - Easy system control"
    echo ""
    
    echo "🚀 Quick Start:"
    echo "  1. Start services: ~/llm-manager.sh start"
    echo "  2. Install a model: ~/llm-manager.sh install"
    echo "  3. Open web interface: ~/llm-manager.sh open"
    echo ""
    
    echo "🛠  Management Commands:"
    echo "  • System control: ~/llm-manager.sh [start|stop|status]"
    echo "  • Model management: ~/llm-manager.sh models"
    echo "  • Diagnostics: ~/llm-manager.sh diagnose"
    echo "  • Full verification: ~/ollama-webui-verify.sh"
    echo ""
    
    # Show access URLs
    local web_ports=(8080 3000)
    echo "🌐 Access URLs:"
    for port in "${web_ports[@]}"; do
        if curl -s http://localhost:$port > /dev/null 2>&1; then
            echo "  • Local: http://localhost:$port"
            if [ "$OS" = "Linux" ]; then
                local ip=$(hostname -I | awk '{print $1}' 2>/dev/null)
            else
                local ip=$(ifconfig | grep "inet " | grep -v "127.0.0.1" | head -1 | awk '{print $2}' 2>/dev/null)
            fi
            if [ ! -z "$ip" ] && [ "$ip" != "localhost" ]; then
                echo "  • Network: http://$ip:$port"
            fi
            break
        fi
    done
    
    echo ""
    echo "💡 Next Steps:"
    echo "  1. Try the web interface - create your first account"
    echo "  2. Install some models for your hardware"
    echo "  3. Start chatting with your local AI!"
    echo ""
    
    print_info "Need help? Run: ~/llm-manager.sh diagnose"
}

# Clean up installations
clean_installation() {
    print_header "Cleaning Up LLM Installation"
    
    echo "⚠️  This will remove:"
    echo "  • All Docker containers and images"
    echo "  • All downloaded models"
    echo "  • Configuration files"
    echo "  • Management scripts"
    echo ""
    
    read -p "Are you sure you want to clean everything? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cleanup cancelled."
        exit 0
    fi
    
    # Stop services first
    print_info "Stopping services..."
    bash ~/llm-manager.sh stop 2>/dev/null || true
    
    # Remove Docker containers and volumes
    if command -v docker &> /dev/null; then
        local docker_cmd
        if groups $USER | grep -q docker 2>/dev/null; then
            docker_cmd="docker"
        else
            docker_cmd="sudo docker"
        fi
        
        echo "Removing Docker containers and volumes..."
        $docker_cmd stop open-webui 2>/dev/null || true
        $docker_cmd rm open-webui 2>/dev/null || true
        $docker_cmd volume rm open-webui 2>/dev/null || true
        $docker_cmd rmi ghcr.io/open-webui/open-webui:main 2>/dev/null || true
    fi
    
    # Remove Ollama models
    if command -v ollama &> /dev/null; then
        echo "Removing all Ollama models..."
        ollama list | tail -n +2 | awk '{print $1}' | xargs -I {} ollama rm {} 2>/dev/null || true
    fi
    
    # Remove management scripts
    echo "Removing management scripts..."
    rm -f ~/llm-manager.sh
    rm -f ~/ollama-launcher.sh
    rm -f ~/ollama-models.sh
    rm -f ~/openwebui-manager.sh
    rm -f ~/ollama-webui-verify.sh
    rm -f ~/openwebui-troubleshoot.sh
    
    # Remove model library
    rm -rf ~/ollama-models/
    
    print_success "Cleanup complete!"
    echo "Note: Ollama and Docker are still installed but can be removed manually if desired."
}

# Main command dispatcher
main() {
    case "${1:-help}" in
        install)
            install_full
            ;;
        status)
            check_status
            ;;
        update)
            print_info "Updating all components..."
            # Update Ollama
            curl -fsSL https://ollama.com/install.sh | sh
            # Update WebUI via management script
            if [ -f ~/llm-manager.sh ]; then
                bash ~/llm-manager.sh update
            fi
            ;;
        troubleshoot)
            if [ -f "$SCRIPT_DIR/universal_diagnostics.sh" ]; then
                bash "$SCRIPT_DIR/universal_diagnostics.sh"
            else
                print_error "Diagnostic script not found"
                exit 1
            fi
            ;;
        models)
            manage_models
            ;;
        clean)
            clean_installation
            ;;
        help|--help|-h)
            show_usage
            ;;
        *)
            print_error "Unknown command: $1"
            echo ""
            show_usage
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
